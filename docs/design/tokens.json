{
  "$description": "Design tokens for [name]. Source: Foundations board, October 2026. Same values as tokens.css.",
  "color": {
    "ink": { "$value": "#08080B", "$description": "Page background; text on accent and white buttons" },
    "stage": { "$value": "#0F0F13", "$description": "Video stage, inputs" },
    "surface": { "$value": "#141418", "$description": "Cards, panels, bars, modals" },
    "raised": { "$value": "#1D1D22", "$description": "Secondary buttons, chips, list rows, timeline clips; stage border" },
    "selected": { "$value": "#26262C", "$description": "Selected timeline clip" },
    "line": { "$value": "#2C2C33", "$description": "Card, bar and button borders; progress track" },
    "line-strong": { "$value": "#3A3A44", "$description": "Outline chips, dashed empty states" },
    "line-input": { "$value": "#4A4A55", "$description": "Input and select borders" },
    "text": { "$value": "#FFFFFF", "$description": "Main text. 20.0:1 on ink" },
    "text-muted": { "$value": "#A3A3AD", "$description": "Leads, labels, hints, time codes. 8.0:1 on ink" },
    "text-faint": { "$value": "#8A8A94", "$description": "Placeholders and footnotes only. 5.9:1 on ink" },
    "on-accent": { "$value": "#08080B", "$description": "Text and icons on accent" },
    "accent": { "$value": "#FF4A1C", "$description": "Default accent. One loud thing per screen. Ink on it 6.0:1" },
    "accent-option-violet": { "$value": "#7C5CFF", "$description": "Alternative accent. Ink on it 4.6:1" },
    "accent-option-blue": { "$value": "#4C7DFF", "$description": "Alternative accent. Ink on it 5.4:1" },
    "scrim": { "$value": "rgba(8, 8, 11, 0.76)", "$description": "Behind a modal" }
  },
  "demoBrand": {
    "$description": "Colours of the demo brand inside example videos. Real videos use the user's brand. Never used in the interface.",
    "blue": { "$value": "#2D4BFF" },
    "yellow": { "$value": "#FFD23F" },
    "cream": { "$value": "#F3F1EC" },
    "forest": { "$value": "#0E3B2E" },
    "lime": { "$value": "#B8F35A" },
    "purple": { "$value": "#5B34D6" },
    "coral": { "$value": "#FF8A5B" }
  },
  "font": {
    "sans": { "$value": "'Onest', 'Segoe UI', system-ui, sans-serif", "$description": "Weights 400, 500, 600, 700, 800" },
    "mono": { "$value": "'JetBrains Mono', 'Courier New', monospace", "$description": "Weights 400, 500" }
  },
  "type": {
    "hero": { "size": "clamp(44px, 7.5vw, 96px)", "weight": 800, "tracking": "-0.04em", "leading": 0.98, "$description": "Landing hero only" },
    "display": { "size": "clamp(36px, 5.4vw, 68px)", "weight": 800, "tracking": "-0.035em", "leading": 1.02 },
    "title": { "size": "clamp(32px, 4.4vw, 52px)", "weight": 800, "tracking": "-0.035em", "leading": 1.04 },
    "section": { "size": "clamp(32px, 4vw, 44px)", "weight": 800, "tracking": "-0.03em", "leading": 1.05 },
    "heading": { "size": "26px", "weight": 700, "tracking": "-0.02em", "leading": 1.2 },
    "card-title": { "size": "22px", "weight": 700, "tracking": "-0.02em", "leading": 1.2, "$description": "20px in compact cards" },
    "bar-title": { "size": "18px", "weight": 700, "tracking": "-0.01em", "leading": 1.3 },
    "lead": { "size": "18px", "weight": 400, "tracking": "0", "leading": 1.45, "color": "text-muted", "$description": "17px on narrow pages" },
    "body": { "size": "16px", "weight": 400, "tracking": "0", "leading": 1.45, "$description": "15px in dense panels; 700 on solid buttons" },
    "small": { "size": "14px", "weight": 400, "tracking": "0", "leading": 1.45 },
    "label": { "size": "13px", "weight": 500, "tracking": "0", "leading": 1.4, "color": "text-muted" },
    "sticker": { "size": "13px", "weight": 800, "tracking": "0.04em", "transform": "uppercase" },
    "mono": { "size": "13px", "weight": 400, "family": "mono", "$description": "12px for meta lines" }
  },
  "space": {
    "4": { "$value": "4px" }, "8": { "$value": "8px" }, "12": { "$value": "12px" },
    "14": { "$value": "14px", "$description": "Gap between cards and tiles in a grid" },
    "16": { "$value": "16px" }, "20": { "$value": "20px" }, "24": { "$value": "24px" }, "28": { "$value": "28px" },
    "32": { "$value": "32px", "$description": "Page side padding on desktop; 16px on phones" },
    "44": { "$value": "44px", "$description": "Between page sections" }
  },
  "width": {
    "task": { "$value": "880px" },
    "wide": { "$value": "1216px" },
    "modal": { "$value": "500px" }
  },
  "radius": {
    "pill": { "$value": "999px" }, "panel": { "$value": "28px" }, "frame": { "$value": "24px" },
    "row": { "$value": "18px" }, "input": { "$value": "16px" }, "clip": { "$value": "14px" }, "small": { "$value": "12px" }
  },
  "size": {
    "touch-min": { "$value": "44px" }, "button-lg": { "$value": "52px" }, "button": { "$value": "44px" },
    "input": { "$value": "52px" }, "input-dense": { "$value": "48px" },
    "icon-button": { "$value": "44px", "$description": "48px for play and send" },
    "icon": { "$value": "18px", "$description": "17-18px in buttons, 22-24px standalone; stroke 1.8" }
  },
  "shadow": {
    "float": { "$value": "0 24px 60px rgba(0, 0, 0, 0.6)", "$description": "Modals and tilted video frames only" }
  },
  "selection": {
    "outline": { "$value": "2px solid {color.accent}" },
    "offset": { "$value": "8px" }
  }
}
